{
  "mcpServers": {
    "algobharat-reputation-credit-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Algorand",
        "PROJECT_TICKER": "ABREP"
      },
      "tools": [
        {
          "name": "verify_abrep_invariants",
          "description": "Verifies deterministic invariants for AlgoBharat Reputation Credit AI on Algorand."
        },
        {
          "name": "execute_abrep_action",
          "description": "Executes authenticated Identity state transition."
        }
      ]
    }
  }
}